[Unit]
Description=WearOrder AI API
After=network.target
Wants=network-online.target

[Service]
Type=simple
User=wearorder
Group=wearorder
WorkingDirectory=/opt/wearorder
ExecStart=/opt/wearorder/wearorder-api -config /etc/wearorder/wearorder.env
Restart=on-failure
RestartSec=3s

# Override config knobs without editing the env file:
#   sudo systemctl edit wearorder-api
# and put `[Service]\nEnvironment=KEY=VALUE` overrides there.

# Reasonable file descriptor cap for an HTTP server.
LimitNOFILE=65535

# Hardening — locks the process down to its data directory.
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
ReadWritePaths=/opt/wearorder/data
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
RestrictNamespaces=yes
RestrictRealtime=yes
LockPersonality=yes

[Install]
WantedBy=multi-user.target
