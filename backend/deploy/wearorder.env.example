# Copy this file to /etc/wearorder/wearorder.env and edit.
# Anything set in the systemd unit's Environment= overrides this file.

# HTTP listener. Bind to localhost since Nginx terminates TLS in front.
LISTEN_ADDR=127.0.0.1:8080

# SQLite database path. Must be writable by the wearorder user.
DATA_PATH=/opt/wearorder/data/wearorder.db

# Admin login. Change ADMIN_INITIAL_PASSWORD before first launch — if
# unset, a random one is printed to stderr on first start (look in
# `journalctl -u wearorder-api`).
ADMIN_USERNAME=admin
# ADMIN_INITIAL_PASSWORD=your-strong-password

# 32-byte hex secret for session cookies. Generate with:
#   openssl rand -hex 32
# If unset, an ephemeral one is generated on each start (admin is
# logged out on every restart).
# SESSION_SECRET=replace-with-openssl-rand-hex-32

# Per-device daily call cap on the public API.
RATE_LIMIT_PER_DAY=30

# Per-LLM-call timeout in seconds.
REQUEST_TIMEOUT_SEC=60
